# Copy to .env for local development. Never commit real values.
ANGELA_PROJECT_ROOT=.
ANGELA_RUNTIME_DIR=.runtime
ANGELA_CDE_DATABASE=.runtime/cde_trials.sqlite3
ANGELA_DISEASE_CONCEPTS=cde-data/config/disease_concepts.json
ANGELA_ORCHESTRATION_ENABLED=false
ANGELA_FAST_PATH_ENABLED=true
ANGELA_REQUEST_STATE_ENABLED=false
ANGELA_LLM_ROUTER_ENABLED=false
ANGELA_LLM_ROUTER_MODEL=your-model-name
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.example.invalid/v1
HERMES_HOME=/path/to/hermes-home
ANGELA_COMPACTOR_DB=/path/to/hermes-home/session-compactor.db
ANGELA_BROWSER_WORKER_CONFIG=cde-demo/cde-browser-worker/config/worker.local.yaml
